# Environment shared by interactive and non-interactive zsh processes.
# Keep this file fast and free of command output.

export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
export NVM_SYMLINK_CURRENT=true

# Use stable paths so child processes can find tools without shell functions.
# Preserve paths injected by terminals, IDEs, and agents.
typeset -U path PATH
path=(
  "$NVM_DIR/current/bin"
  "$HOME/.local/bin"
  /opt/homebrew/bin
  /opt/homebrew/sbin
  /usr/local/bin
  $path
)
export PATH
