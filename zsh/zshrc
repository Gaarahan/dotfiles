export HOMEBREW_NO_AUTO_UPDATE=true
alias t=todo.sh
alias vim=nvim

bindkey -v # use vim mode

# Remove mode switching delay.
KEYTIMEOUT=5

# Change cursor shape for different vi modes.
function zle-keymap-select {
  if [[ ${KEYMAP} == vicmd ]] ||
    [[ $1 = 'block' ]]; then
      echo -ne '\e[1 q'

    elif [[ ${KEYMAP} == main ]] ||
      [[ ${KEYMAP} == viins ]] ||
      [[ ${KEYMAP} = '' ]] ||
      [[ $1 = 'beam' ]]; then
          echo -ne '\e[5 q'
  fi
}
zle -N zle-keymap-select

# Use beam shape cursor on startup.
echo -ne '\e[5 q'

# fix cursor in vi mode
_fix_cursor() {
  echo -ne '\e[5 q'
}
precmd_functions+=(_fix_cursor)

set_proxy() {
  export http_proxy=http://127.0.0.1:7890
  export https_proxy=http://127.0.0.1:7890
}
unset_proxy() {
  unset http_proxy
  unset https_proxy
}
# set_proxy

_find_dir() {
  local dir
  dir=$(find ${1:-.} -path '*/\.*' -prune \
                  -o -type d -print 2> /dev/null | fzf +m) &&
  cd "$dir"
}

_find_history() {
  local cmd
  cmd=$(print -rNC1 -- ${(u)history} | fzf --read0 "$@") &&
  print -rz -- $cmd
}


# enable history ignore
export HISTCONTROL=ignorespace
bindkey -s "^G" " lazygit\n"
bindkey -r "^S"
bindkey -s "^P" " pet exec\n"
bindkey -s "^O" " _find_dir\n"
bindkey -s "^R" " _find_history\n"

stty eof undef  # prevent C-d to close panel

_lazy_load_nvm() {
  local nvm_script
  nvm_script="$(_find_nvm_script)" || return 127
  unset -f nvm node npm npx pnpm yarn corepack
  . "$nvm_script"
  [ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"
  return 0
}

_find_nvm_script() {
  local candidate
  for candidate in \
    "$NVM_DIR/nvm.sh" \
    /opt/homebrew/opt/nvm/nvm.sh \
    /usr/local/opt/nvm/nvm.sh
  do
    if [ -s "$candidate" ]; then
      print -r -- "$candidate"
      return 0
    fi
  done
  return 1
}

_should_lazy_load_nvm() {
  _find_nvm_script >/dev/null || return 1
  [ -z "$CODEX_SANDBOX" ] || return 1
  (( ! $+functions[nvm] )) || return 1
}

if _should_lazy_load_nvm; then
  for cmd in nvm node npm npx pnpm yarn corepack; do
    eval "
    $cmd() {
      _lazy_load_nvm || return \$?
      if ! command -v $cmd >/dev/null 2>&1; then
        print -u2 \"zsh: command not found: $cmd\"
        return 127
      fi
      if [ \"$cmd\" = \"nvm\" ]; then
        nvm \"\$@\"
      else
        command $cmd \"\$@\"
      fi
    }
    "
  done
fi
